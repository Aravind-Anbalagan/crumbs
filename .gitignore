# ==========================================
# Crumbs Core System - Git Ignore Configuration
# ==========================================

# --- Maven & Java Compilations ---
target/
*.class
*.war
*.ear
*.jar

# --- Nested React UI Frontend (frontend-app) ---
frontend-app/node_modules/
frontend-app/dist/
frontend-app/.env.local
frontend-app/.env.development.local
frontend-app/.env.production.local

# --- Local Secrets & Configurations ---
# Do NOT ignore the main application.properties file! 
# Only ignore local backup variations if you create them.
*.env
.env.local

# --- IDE & System Bloat ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# --- Logs & Diagnostics ---
*.log
TEST*.xml