<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender for Railway (logs visible in Railway dashboard) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Turn off everything globally -->
    <root level="OFF" />

    <!-- Only log your app -->
    <logger name="com.crumbs.trade" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

</configuration>